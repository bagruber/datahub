    {
      "id": "mentale-modelle",
      "titel": "Wo Menschen suchen",
      "zeile": "Teilprojekt Mentale Modelle",
      "bloecke": [
        {
          "typ": "text",
          "text": "Mentale Modelle sind Vorstellungen davon, wo eine Information stehen müsste und was zusammengehört. Passt die Website nicht dazu, verirrt man sich. Die Gruppe sprach mit {{mm.gespraeche}} Personen, ließ Themen der heutigen Website auf Zetteln sortieren (Card Sorting) und Aufgaben wie eine Terminbuchung laut denkend lösen."
        },
        {
          "typ": "befunde",
          "eintraege": [
            {
              "kern": "Die Startseite ist überladen.",
              "text": "Zu viel auf einmal, kein klarer Einstieg."
            },
            {
              "kern": "Menüs passen nicht.",
              "text": "Unter „Rathaus & Service“ steht vieles, das dort niemand sucht."
            },
            {
              "kern": "Die Suche führt nicht weiter.",
              "text": "Viele weichen auf Google aus."
            },
            {
              "kern": "Unklar, für wen etwas ist.",
              "text": "Bürger, Fachleute, Gäste: Gerade Besucher finden wenig."
            },
            {
              "kern": "Behördensprache.",
              "text": "Begriffe wie „BayernPortal“ oder „Mein Moosburg“ bleiben unerklärt."
            }
          ]
        },
